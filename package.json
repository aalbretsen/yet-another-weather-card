{
  "name": "yet-another-weather-card",
  "version": "1.0.0",
  "description": "A configurable weather card for Home Assistant — three section layout, i18n, no charts.",
  "keywords": [
    "home-assistant",
    "lovelace",
    "weather",
    "custom-card",
    "hacs"
  ],
  "homepage": "https://github.com/aalbretsen/yet-another-weather-card#readme",
  "bugs": {
    "url": "https://github.com/aalbretsen/yet-another-weather-card/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aalbretsen/yet-another-weather-card.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/yet-another-weather-card.js",
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "build:prod": "NODE_ENV=production rollup -c rollup.config.mjs",
    "watch": "rollup -c rollup.config.mjs -w",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,json}\" \"*.{json,md,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\" \"*.{json,md,mjs}\""
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "rollup": "^4.64.5",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
